# Every text file is LF in the working tree on every platform, because rustfmt and
# Prettier check for LF; a CRLF checkout would fail both on Windows only.
* text=auto eol=lf
# Tauri regenerates these with LF on every build; pin LF so autocrlf doesn't show them as modified.
src-tauri/permissions/autogenerated/** text eol=lf
