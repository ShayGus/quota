# Build output and local tool state. Nothing here is ever committed.

# Rust
/src-tauri/target/
**/*.rs.bk
# Where Cargo built before the workspace moved under src-tauri. A checkout that
# built then still has it; ignoring it keeps Prettier and ESLint off it.
/target/

# Tauri build output. `tauri-build` regenerates these on every compile.
/src-tauri/gen/
/src-tauri/permissions/autogenerated/

# Node
node_modules/
dist/
*.tsbuildinfo

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Interface-test output (Playwright)
test-results/
playwright-report/
