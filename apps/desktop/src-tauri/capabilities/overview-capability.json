{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overview-capability",
  "description": "The floating overview window. It reads snapshots and events and issues only the commands the overview needs. No store, SQL, filesystem, shell, or HTTP permission is granted here.",
  "windows": ["overview"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-available-monitors",
    "core:event:default",
    "quota:allow-get-snapshot",
    "quota:allow-list-provider-capabilities",
    "quota:allow-refresh-accounts",
    "quota:allow-set-monitoring-state",
    "quota:allow-set-account-enabled",
    "quota:allow-rename-account",
    "quota:allow-disconnect-account",
    "quota:allow-open-provider-usage-page",
    "quota:allow-set-overview-mode",
    "quota:allow-set-overview-always-on-top",
    "quota:allow-fit-overview-to-accounts",
    "quota:allow-reset-overview-position",
    "quota:allow-export-sanitized-diagnostics"
  ]
}