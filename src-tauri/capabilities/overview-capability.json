{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overview-capability",
  "description": "The overview window. It reads snapshots and events and issues only the commands the overview needs. It may ask the host to show the settings window, run the add-account wizard (begin, confirm, and cancel a connection attempt), save indicator-style and overview mode/topmost preferences, and move, resize, fit, or reset the overview window. Full preference writes and history clearing are not granted. No store, SQL, filesystem, shell, or HTTP permission is granted here.",
  "windows": ["overview"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-available-monitors",
    "core:event:default",
    "allow-get-snapshot",
    "allow-list-provider-capabilities",
    "allow-refresh-accounts",
    "allow-set-monitoring-state",
    "allow-set-account-enabled",
    "allow-rename-account",
    "allow-disconnect-account",
    "allow-open-provider-usage-page",
    "allow-set-indicator-style",
    "allow-set-overview-mode",
    "allow-set-overview-always-on-top",
    "allow-fit-overview-to-accounts",
    "allow-fit-overview-height",
    "allow-reset-overview-position",
    "allow-export-sanitized-diagnostics",
    "allow-reconnect-account",
    "allow-begin-connection",
    "allow-cancel-connection",
    "allow-confirm-connection",
    "allow-open-settings-window"
  ]
}
