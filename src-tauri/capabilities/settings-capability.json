{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "The settings window. It manages accounts and preferences, and it drives the overview window's mode, topmost flag, geometry and usage pages. It may not read the account snapshot for ranking beyond what the shared commands return.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:event:default",
    "allow-get-snapshot",
    "allow-list-provider-capabilities",
    "allow-update-preferences",
    "allow-set-polling-preferences",
    "allow-begin-connection",
    "allow-cancel-connection",
    "allow-reconnect-account",
    "allow-set-account-enabled",
    "allow-rename-account",
    "allow-disconnect-account",
    "allow-clear-local-history",
    "allow-export-sanitized-diagnostics",
    "allow-set-overview-mode",
    "allow-set-overview-always-on-top",
    "allow-fit-overview-to-accounts",
    "allow-reset-overview-position",
    "allow-open-provider-usage-page",
    "allow-open-settings-window"
  ]
}
