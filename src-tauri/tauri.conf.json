{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota",
  "version": "0.1.0",
  "identifier": "app.quota.monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overview",
        "title": "Quota",
        "url": "index.html",
        "width": 440,
        "height": 640,
        "minWidth": 400,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "Quota settings",
        "parent": "overview",
        "url": "index.html#/settings",
        "width": 780,
        "height": 600,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      },
      {
        "label": "widget",
        "title": "Quota widget",
        "url": "index.html#/widget",
        "width": 316,
        "height": 172,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421; font-src 'self' data:",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": ["overview-capability", "settings-capability", "widget-capability"],
      "pattern": {
        "use": "brownfield"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
