// Build tooling. Node globals live here only, never in the renderer project.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "eslint.config.js"
  ]
}
